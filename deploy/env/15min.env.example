# Bot #2: 15Min 55/45, no trading-TF MA, no volume filter, 1Hour MA20 trend
# confirmation. Overrides zero out the 15Min profile's MA200/vol settings —
# walk-forward tested 2026-07-11, see backtest_results.csv.
# Copy to 15min.env and fill in keys (use a DIFFERENT paper account or a
# non-overlapping SYMBOLS basket — bots sharing an account fight over
# positions).
ALPACA_API_KEY=paper_account_key_here
ALPACA_SECRET_KEY=paper_account_secret_here
ALPACA_PAPER=true
TIMEFRAME=15Min
SYMBOLS=QQQ,GLD,IWM,SPY
NOTIONAL=1000
RSI_BUY_LEVEL=55
RSI_SELL_LEVEL=45
TREND_MA_PERIOD=0
VOLUME_MULT=0
HTF_MA_PERIOD=20
HTF_TIMEFRAME=1Hour
POLL_SECONDS=450
TRADES_DB=/opt/rsi-midline-bot/trades-15min.db
