# Bot #3: 1Hour RSI-21 60/40 plain — no trend MA, no volume, no HTF filter.
# RSI-21's smoothing replaces the 1Day-MA50 confirmation: beats it on both
# walk-forward windows incl. with COST_BPS=5 (sweep 2026-07-12, 'EXP swp1h'
# rows in backtest_results.csv). Prior config: p14 60/40 + HTF 1Day MA50.
# Copy to 1hour.env and fill in keys (use a DIFFERENT paper account or a
# non-overlapping SYMBOLS basket — bots sharing an account fight over
# positions).
ALPACA_API_KEY=paper_account_key_here
ALPACA_SECRET_KEY=paper_account_secret_here
ALPACA_PAPER=true
TIMEFRAME=1Hour
SYMBOLS=QQQ,GLD,IWM,SPY
# 25% of current equity per position: with 4 symbols this is fully invested
# when everything signals. Reset the paper account to $2,000 so sizing
# mimics the planned live account ($500 slots that compound with equity).
NOTIONAL_PCT=25
RSI_PERIOD=21
RSI_BUY_LEVEL=60
RSI_SELL_LEVEL=40
TREND_MA_PERIOD=0
VOLUME_MULT=0
HTF_MA_PERIOD=0
POLL_SECONDS=1800
TRADES_DB=/opt/rsi-midline-bot/trades-1hour.db
