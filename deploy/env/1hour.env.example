# Bot #3: 1Hour 60/40, no trading-TF MA, no volume filter, 1Day MA50 trend
# confirmation — walk-forward tested 2026-07-11, see backtest_results.csv.
# Copy to 1hour.env and fill in keys (use a DIFFERENT paper account or a
# non-overlapping SYMBOLS basket — bots sharing an account fight over
# positions).
ALPACA_API_KEY=paper_account_key_here
ALPACA_SECRET_KEY=paper_account_secret_here
ALPACA_PAPER=true
TIMEFRAME=1Hour
SYMBOLS=QQQ,GLD,IWM,SPY
NOTIONAL=1000
RSI_BUY_LEVEL=60
RSI_SELL_LEVEL=40
TREND_MA_PERIOD=0
VOLUME_MULT=0
HTF_MA_PERIOD=50
HTF_TIMEFRAME=1Day
POLL_SECONDS=1800
TRADES_DB=/opt/rsi-midline-bot/trades-1hour.db
