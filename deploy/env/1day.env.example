# Bot #1: 1Day 55/40 band + MA50 (the profiles.json entry — no overrides).
# Copy to 1day.env and fill in keys. systemd EnvironmentFile syntax:
# full-line comments only, no inline comments, no quotes needed.
ALPACA_API_KEY=paper_account_key_here
ALPACA_SECRET_KEY=paper_account_secret_here
ALPACA_PAPER=true
TIMEFRAME=1Day
SYMBOLS=QQQ,GLD,IWM,SPY
NOTIONAL=1000
# Separate journal per instance: avoids concurrent-write locking on SQLite
# and keeps each experiment's trades cleanly separated.
TRADES_DB=/opt/rsi-midline-bot/trades-1day.db
