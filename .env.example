# Copy to .env and fill in — the bot loads this file automatically at startup.
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here

# "true" (default) uses the paper-trading endpoint; "false" trades real money
ALPACA_PAPER=true

# Strategy settings (all optional — defaults shown)
SYMBOLS=SPY,AAPL,MSFT
TIMEFRAME=15Min          # 1Min, 5Min, 15Min, 1Hour, 1Day
RSI_PERIOD=14
MIDLINE=50
# Band variant: buy above one level, sell below another (both default to MIDLINE).
# RSI_BUY_LEVEL=55
# RSI_SELL_LEVEL=45
# Trend filter: only buy when price is above this moving average, in bars (0 = off)
# TREND_MA_PERIOD=200
# Moving-average type for the trend filter: sma (default), ema, or hma.
# MA_TYPE=sma
# Volume filter: only buy when signal-bar volume >= this multiple of the
# VOLUME_LOOKBACK-bar average (0 = off). Helps on intraday, too strict on 1Day.
# VOLUME_MULT=1.5
# VOLUME_LOOKBACK=20
# Trailing stop: server-side GTC stop this % below the high-water mark (0 = off).
# Entries switch to whole-share sizing when enabled.
# TRAIL_PERCENT=8
# Higher-timeframe trend confirmation: only buy when the close is above this
# MA on HTF_TIMEFRAME bars (resampled from the trading bars; 0 = off).
# Intraday timeframes only. e.g. trade 15Min but require the 1Hour trend up.
# HTF_MA_PERIOD=50
# HTF_TIMEFRAME=1Hour      # 1Hour, 4Hour, 1Day
# Multi-timeframe RSI confirmation: only buy when RSI(RSI_PERIOD) on
# HTF_TIMEFRAME bars is above this level (0 = off). Intraday only. In
# backtests this gates EVERY variant (names get a [+... RSI>x] suffix).
# HTF_RSI_LEVEL=50
NOTIONAL=1000            # dollars per new position
# Or size as % of current account equity instead (overrides NOTIONAL; capped
# by available cash so entries never use margin). 25 with 4 symbols = fully
# invested when all 4 are in a position.
# NOTIONAL_PCT=25
POLL_SECONDS=60          # loop mode check interval
BACKTEST_DAYS=365
# TRAIN_SPLIT=0.7          # tune mode: fraction of history used for training
# Simulator friction: basis points of trade value charged per side in
# backtest/tune/portfolio (0 = frictionless legacy numbers). ~2-5 is a
# reasonable haircut for liquid ETFs at market.
# COST_BPS=0
# Bar adjustment from Alpaca: raw | split | dividend | all. Default 'all'
# (removes split/dividend price gaps). Use 'raw' to reproduce pre-2026-07-12
# backtest baselines.
# BAR_ADJUSTMENT=all
# Starting cash for the `portfolio` simulator (not used by live trading).
# START_EQUITY=2000
